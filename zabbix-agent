#!/bin/bash
# 文件名: install-zbx6.sh
# 用法  : sudo ./install-zbx6.sh <Zabbix服务器IP>

set -e

# ---------- 参数 ----------
ZBX_SRV=${1}
# 自动获取本机主网卡 IP 做 Hostname
HOSTNAME=$(ip route get 1 | awk '{print $7}' | head -1)


if [ -r /etc/os-release ]; then
    . /etc/os-release
    PRETTY_NAME="${PRETTY_NAME:-$NAME}"
    case "$ID" in
        ubuntu)
            DISTRO="ubuntu"
            VER="${VERSION_ID}"
            ;;
        debian)
            DISTRO="debian"
            VER="${VERSION_ID}"
            ;;
        *)
            DISTRO="unknown"
            VER="unknown"
            ;;
    esac
else
    DISTRO="unknown"
    VER="unknown"
fi

# 去掉点号，生成 zabbix deb 包常用的版本号串（例如 22.04 -> 22.04、11 -> 11）
LRS=$VER

echo "DISTRO=$DISTRO"
echo "VERSION=$VER"

# ---------- 1. 安装官方仓库 ----------
DEB_URL="https://repo.zabbix.com/zabbix/6.0/$DISTRO/pool/main/z/zabbix-release/zabbix-release_latest_6.0+$DISTRO$VER_all.deb"
wget -q "$DEB_URL" -O /tmp/zabbix-release.deb
sudo dpkg -i /tmp/zabbix-release.deb
sudo apt update

# ---------- 2. 安装 agent ----------
sudo apt install -y zabbix-agent

# ---------- 3. 写入配置 ----------
sudo sed -i "s/^Server=.*/Server=$ZBX_SRV/"          /etc/zabbix/zabbix_agentd.conf
sudo sed -i "s/^ServerActive=.*/ServerActive=$ZBX_SRV/" /etc/zabbix/zabbix_agentd.conf
sudo sed -i "s/^Hostname=.*/Hostname=$HOSTNAME/"    /etc/zabbix/zabbix_agentd.conf

# ---------- 4. 启动并设为开机自启 ----------
sudo systemctl enable --now zabbix-agent

echo "✅ Zabbix Agent 6.0 安装完成！"
echo "   Server/ServerActive : $ZBX_SRV"
echo "   Hostname (IP)       : $HOSTNAME"
